<?xml version="1.0" encoding="UTF-8" ?>
<!--
  {{ ansible_managed }}

  Isaac Sim 과 ROS 2 노드가 쓰는 Fast DDS 전송 프로파일.
  두 가지 목적으로 쓰이며, 필요한 쪽만 켜면 된다.

  1) 공유메모리(SHM) 전송 제거  — isaac_sim_fastdds_disable_shm
     같은 호스트의 서로 다른 컨테이너에 있을 때 SHM 로케이터를 받아든 쪽이
     이를 쓰려다 실패하는 문제를 피한다. 같은 호스트에서 그냥 돌린다면 켜지 말 것
     (전송량이 약 1,200배로 늘어난다).

  2) 인터페이스 화이트리스트    — isaac_sim_fastdds_interface_whitelist
     기본 상태의 Fast DDS 는 로케이터 목록에 127.0.0.1 을 함께 announce 하고,
     원격 상대는 모든 로케이터로 데이터를 보내므로 같은 샘플이 한 벌 더 나간다.
     실제 IP 만 announce 하게 하면 그 낭비가 사라진다. SHM 은 그대로 유지된다.

  자세한 근거와 실측은 roles/isaac_sim/dds-middleware.md 6장 참조.

  이 파일을 쓰려면 FASTRTPS_DEFAULT_PROFILES_FILE 이 이 경로를 가리켜야 한다
  (isaac_sim role 이 만드는 실행 래퍼가 자동으로 설정한다).
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles" >
    <transport_descriptors>
{% if not isaac_sim_fastdds_disable_shm | bool %}
        <transport_descriptor>
            <transport_id>ShmTransport</transport_id>
            <type>SHM</type>
        </transport_descriptor>
{% endif %}
        <transport_descriptor>
            <transport_id>UdpTransport</transport_id>
            <type>UDPv4</type>
{% if _isaac_sim_fastdds_whitelist | length > 0 %}
            <interfaceWhiteList>
{% for addr in _isaac_sim_fastdds_whitelist %}
                <address>{{ addr }}</address>
{% endfor %}
            </interfaceWhiteList>
{% endif %}
        </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="isaac_sim_transport" is_default_profile="true">
        <rtps>
            <userTransports>
{% if not isaac_sim_fastdds_disable_shm | bool %}
                <transport_id>ShmTransport</transport_id>
{% endif %}
                <transport_id>UdpTransport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>
        </rtps>
    </participant>
</profiles>
